{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svaf:schemas:metadata",
  "title": "SVAF Metadata Schema",
  "description": "Schema for SVAF container metadata (as built, format version 0.x)",
  "type": "object",
  "required": [
    "svaf_version",
    "source",
    "created_utc"
  ],
  "properties": {
    "svaf_version": {
      "type": "string",
      "description": "SVAF format version (major.minor)",
      "pattern": "^\\d+\\.\\d+$"
    },
    "source": {
      "type": "string",
      "description": "Path or URI of the source media file"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp of the container (UTC)"
    },
    "audio": {
      "type": "object",
      "description": "Master audio encoding parameters",
      "properties": {
        "codec": { "type": "string" },
        "sample_rate_hz": { "type": "integer", "minimum": 1 }
      }
    },
    "proxy": {
      "type": "object",
      "description": "Optional proxy video encoding parameters",
      "properties": {
        "codec": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "asr": {
      "type": "object",
      "description": "ASR engine configuration used for transcript.json",
      "properties": {
        "model": { "type": "string" },
        "device": { "type": "string" },
        "compute": { "type": "string" }
      }
    },
    "diarization": {
      "type": "object",
      "description": "Speaker diarization configuration",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "speaker_events": {
      "type": "object",
      "description": "Parameters for deriving speaker_change events",
      "properties": {
        "change_gap_sec": { "type": "number", "minimum": 0 }
      }
    },
    "index": {
      "type": "object",
      "description": "Local search index configuration",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "slides": {
      "type": "object",
      "description": "Slide keyframe extraction configuration",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval_sec": { "type": "number", "exclusiveMinimum": 0 },
        "diff_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_gap_sec": { "type": "number", "minimum": 0 }
      }
    },
    "ocr": {
      "type": "object",
      "description": "OCR configuration for slide keyframes",
      "properties": {
        "enabled": { "type": "boolean" },
        "lang": { "type": "string" }
      }
    },
    "privacy": {
      "type": "object",
      "description": "Container-level privacy metadata (RFC-0001 section 11). If the block is absent, readers MUST apply the fail-closed rule of RFC-0001 section 11.3.",
      "required": ["mode", "biometrics", "consent"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["public", "pseudonymous", "anonymous", "restricted"]
        },
        "biometrics": {
          "type": "string",
          "enum": ["absent", "present", "encrypted"]
        },
        "consent": {
          "type": "string",
          "enum": ["unknown", "given", "denied", "not_required"]
        },
        "retention_days": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": true
}
