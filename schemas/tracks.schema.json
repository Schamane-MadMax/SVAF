{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svaf.org/schemas/tracks.schema.json",
  "title": "SVAF Tracks Schema",
  "description": "Schema for speaker (and future face) tracks (as built, format version 0.x)",
  "type": "object",
  "required": ["speaker_tracks"],
  "properties": {
    "speaker_tracks": {
      "type": "array",
      "description": "One entry per diarized speaker",
      "items": {
        "type": "object",
        "required": ["track_id", "segments"],
        "properties": {
          "track_id": {
            "type": "string",
            "description": "Stable track identifier, e.g. spk:01"
          },
          "identity_id": {
            "type": "string",
            "description": "Reference to identities.json (id)"
          },
          "label": {
            "type": "string",
            "description": "Raw diarization label, e.g. SPEAKER_00 from RTTM"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t_start", "t_end"],
              "properties": {
                "t_start": { "type": "number", "minimum": 0 },
                "t_end": { "type": "number", "minimum": 0 }
              }
            }
          },
          "quality": {
            "type": "object",
            "description": "Provenance and quality metadata",
            "properties": {
              "source": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "face_tracks": {
      "type": "array",
      "description": "Reserved for face tracks (RFC-0001 section 7.3, not yet produced)",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
