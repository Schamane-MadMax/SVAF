{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svaf:schemas:identities",
  "title": "SVAF Identities Schema",
  "description": "Schema for the identity layer (as built, format version 0.x)",
  "type": "object",
  "required": ["identities"],
  "properties": {
    "identities": {
      "type": "array",
      "description": "Stable identities referenced by tracks and events",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identity id, e.g. p:spk_01"
          },
          "type": {
            "type": "string",
            "description": "Kind of identity",
            "enum": ["person", "organization", "role", "unknown"]
          },
          "display_name": {
            "type": "string",
            "description": "Human-readable name or pseudonym"
          },
          "tags": {
            "description": "Namespaced tags, e.g. svaf:identity.role. Canonical form is an object; an empty array occurs in existing containers and MUST be treated as 'no tags'.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                }
              },
              {
                "type": "array",
                "maxItems": 0
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
