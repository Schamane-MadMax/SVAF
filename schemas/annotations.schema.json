{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:svaf:schemas:annotations",
  "title": "SVAF Annotations Schema",
  "description": "Schema for the annotation layer (RFC-0001 section 8). Target definition: no known implementation produces this file yet.",
  "type": "object",
  "required": ["annotations"],
  "properties": {
    "annotations": {
      "type": "array",
      "description": "Human- or machine-authored notes layered over source-derived data",
      "items": {
        "type": "object",
        "required": ["id", "type", "content"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable annotation id, e.g. ann:001"
          },
          "type": {
            "type": "string",
            "enum": ["note", "summary", "correction", "question", "link", "highlight", "hypothesis"]
          },
          "author": {
            "type": "string",
            "description": "Identity id (identities.json) or tool identifier"
          },
          "created_utc": {
            "type": "string",
            "format": "date-time"
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "targets": {
            "type": "array",
            "description": "What the annotation refers to",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": true
            }
          },
          "content": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "version": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
