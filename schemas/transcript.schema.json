{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svaf.org/schemas/transcript.schema.json",
  "title": "SVAF Transcript Schema",
  "description": "Schema for the multilingual transcript layer (as built, format version 0.x)",
  "type": "object",
  "required": [
    "primary_language",
    "transcripts"
  ],
  "properties": {
    "primary_language": {
      "type": "string",
      "description": "ISO 639-1 code of the primary spoken language",
      "pattern": "^[a-z]{2,3}$"
    },
    "transcripts": {
      "type": "array",
      "description": "One entry per language variant (ASR output or translation)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lang", "source", "segments"],
        "properties": {
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          },
          "source": {
            "type": "string",
            "description": "Provenance of this variant, e.g. asr, translation, manual"
          },
          "model": {
            "type": "string",
            "description": "Model identifier that produced this variant"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "text"],
              "properties": {
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 },
                "text": { "type": "string" },
                "words": {
                  "type": "array",
                  "description": "Optional word-level timing",
                  "items": {
                    "type": "object",
                    "required": ["w", "start", "end"],
                    "properties": {
                      "w": { "type": "string" },
                      "start": { "type": "number", "minimum": 0 },
                      "end": { "type": "number", "minimum": 0 },
                      "prob": { "type": "number", "minimum": 0, "maximum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
