{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svaf.org/schemas/transcript.schema.json",
  "title": "SVAF Transcript Schema",
  "description": "Schema for SVAF transcripts",
  "type": "object",
  "required": ["language", "format_version", "segments"],
  "properties": {
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Language code (ISO 639-1)"
    },
    "format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Transcript format version"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "start_time", "end_time", "text"],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^seg_\\d+$",
            "description": "Unique segment identifier"
          },
          "start_time": {
            "type": "number",
            "minimum": 0,
            "description": "Segment start time in seconds"
          },
          "end_time": {
            "type": "number",
            "minimum": 0,
            "description": "Segment end time in seconds"
          },
          "speaker_id": {
            "type": "string",
            "description": "Reference to speaker identity"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Transcript text"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Transcription confidence score"
          },
          "words": {
            "type": "array",
            "description": "Optional word-level timestamps",
            "items": {
              "type": "object",
              "required": ["word", "start", "end"],
              "properties": {
                "word": {
                  "type": "string"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "transcription_engine": {
          "type": "string",
          "description": "Engine used for transcription"
        },
        "transcription_date": {
          "type": "string",
          "format": "date-time"
        },
        "word_level_timestamps": {
          "type": "boolean"
        }
      }
    }
  }
}
